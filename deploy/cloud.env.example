# 复制到服务器项目目录的 .env.cloud；实际凭据只在服务器上填写。
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.6-pro
LLM_MAX_COMPLETION_TOKENS=4096
# 不加载本地模型；已有向量仍保存在数据库中。
EMBEDDING_MODEL=
EMBEDDING_PROVIDER=api
EMBEDDING_AUTO_INDEX=0
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANKER_MODEL=
DEMO_REQUIRE_LOGIN=1
DEMO_USERNAME=reviewer
DEMO_PASSWORD=
DEMO_SESSION_SECRET=
DEMO_COOKIE_SECURE=1
DEMO_REQUESTS_PER_MINUTE=10
DEMO_MAX_TRANSLATE_PAGES=20
DEMO_MAX_PAPERS=80
# 加入实际 Docker 网络网关地址，只信任此 HTTPS 代理。
FORWARDED_ALLOW_IPS=127.0.0.1
