# 复制为 .env；不填写模型密钥时仍可使用本地文献管理和原文检索。
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.6-pro
# MiMo 官方接口的可选输出长度上限。
LLM_MAX_COMPLETION_TOKENS=4096
# 可选语义检索；本地 BGE-M3 不需要接口密钥：
# python -m pip install -r requirements-embedding.txt
# python scripts/download_bge_m3.py
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-m3
# 使用兼容的远程向量服务时，将 EMBEDDING_PROVIDER 设为 api。
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=
EMBEDDING_LOCAL_PATH=.local/models/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=512
EMBEDDING_AUTO_INDEX=1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 可选的第二阶段本地精排，不需要额外接口密钥。
# 下载命令：python scripts/download_bge_m3.py --model BAAI/bge-reranker-v2-m3
RERANKER_MODEL=
RERANKER_LOCAL_PATH=.local/models/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_CANDIDATES=40
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
# 可选的 Tesseract 语言数据目录，例如 C:/Program Files/Tesseract-OCR/tessdata。
TESSDATA_PREFIX=
OCR_LANG=eng
# 默认仅监听本机；公网部署前需配置访问控制和请求限额。
APP_HOST=127.0.0.1
APP_PORT=8765
# 公开演示时设置评审强密码；留空时保持本地模式。
DEMO_USERNAME=reviewer
DEMO_REQUIRE_LOGIN=0
DEMO_PASSWORD=
DEMO_SESSION_SECRET=
DEMO_COOKIE_SECURE=0
DEMO_REQUESTS_PER_MINUTE=10
DEMO_MAX_TRANSLATE_PAGES=20
DEMO_MAX_PAPERS=80
