# Copy to .env. Leave blank to use local PDF management and evidence search.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional semantic retrieval, using the same service/key unless overridden.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Optional Tesseract language data, e.g. C:/Program Files/Tesseract-OCR/tessdata
TESSDATA_PREFIX=
OCR_LANG=eng
# Local host by default. Before public hosting add access control and request limits.
APP_HOST=127.0.0.1
APP_PORT=8765
